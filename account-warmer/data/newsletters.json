  "mailchimp_selectors": {
    "email": "#mce-EMAIL, input[name='EMAIL'], input[id*='mce'][type='email']",
    "submit": "#mc-embedded-subscribe, input[type='submit'][value*='Subscribe' i], button[type='submit']"
  },

  "klaviyo_selectors": {
    "email": "input[type='email'][data-testid], .klaviyo-form input[type='email'], input[name='email']",
    "submit": ".klaviyo-form button[type='submit'], button[data-testid*='submit']"
  },

  "generic_selectors": {
    "email": "input[type='email'], input[name='email'], input[placeholder*='email' i], input[placeholder*='Email' i]",
    "submit": "button[type='submit'], input[type='submit'], button:has-text('Subscribe'), button:has-text('Sign up'), button:has-text('Join')"
  },

  "confirmation_patterns": [
    "confirm your subscription",
    "please confirm",
    "verify your email",
    "activate your subscription",
    "confirm your email",
    "complete your signup",
    "you're almost subscribed",
